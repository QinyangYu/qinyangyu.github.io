\NeedsTeXFormat{LaTeX2e}

% Page size
\usepackage[top=1.2cm, bottom=2.6cm, left=1.8cm, right=2.3cm, marginparwidth=1.75cm]{geometry}

% Packages
\usepackage{xcolor}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{tabularx}
\usepackage{ragged2e}

% Font style
\usepackage{fontspec}
\setmainfont{SabonLTStd}[
    Path=./Fonts/Sabon/,
    Extension = .ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-Italic,
    BoldItalicFont=*-BoldItalic
    ]
\newfontfamily\Calluna{Calluna}[
    Path=./Fonts/Calluna/,
    Extension = .otf,
    UprightFont=*-Regular
    ]
\newfontfamily\Courier{CourierNew}[
    Path=./Fonts/Courier/,
    Extension = .ttf,
    UprightFont=*-Regular
    ]
\newfontfamily\CronosLt{CronosProLT}[
    Path=./Fonts/Cronos/,
    Extension = .ttf,
    UprightFont=*-Regular
    ]

% Emph style
\renewcommand{\emph}[1]{\textbf{\fontsize{11pt}{11pt}\selectfont #1}}

% Section block
\newcommand{\sectionBlock}[2]{%
    \noindent
    \begin{minipage}[t]{2.7cm} % Title
    \raggedright
    #1
    \end{minipage}
    \hfill
    \begin{minipage}[t]{13.85cm} % Content
    \raggedright
    #2
    \end{minipage}
    \vspace{25pt}
}

% Section title
\titleformat{\section}{
  \setstretch{1.0}
  \CronosLt\scshape\raggedright
  \fontsize{14.5pt}{14.5pt}\selectfont 
}{}{0em}{}

% Section content

% Publication list
\newcommand{\pubListStart}{\begin{enumerate}[left=0pt, itemsep=3pt]}
\newcommand{\pubListEnd}{\end{enumerate}\vspace{-11pt}}

% Award list
\newcommand{\awardListStart}{\begin{itemize}[left=0pt, itemsep=0pt]}
\newcommand{\awardListEnd}{\end{itemize}\vspace{-11pt}}

% Skill list
\newcommand{\skillListStart}{\begin{itemize}[leftmargin=0pt, label={}, itemsep=0pt]}
\newcommand{\skillListEnd}{\end{itemize}\vspace{-11pt}}

% Keep the gaps between list items and around lists at their natural size.
% (Otherwise TeX may squeeze them, a point or so each, to pull a few more lines onto a page,
%  and the whole page then looks cramped.)
\newcommand*{\@noshrink}[1]{#1=1#1 plus\gluestretch#1\relax}
\newcommand*{\@noshrinklist}{\@noshrink\topsep\@noshrink\parsep\@noshrink\itemsep}
\g@addto@macro\@listI{\@noshrinklist}
\g@addto@macro\@listi{\@noshrinklist}
\g@addto@macro\@listii{\@noshrinklist}
\g@addto@macro\@listiii{\@noshrinklist}
\@listi
\@noshrink\partopsep

% Item list
\newcommand{\itemListStart}{\begin{itemize}[itemsep=0pt]}
\newcommand{\itemListEnd}{\end{itemize}}
% (no space before \vspace: when the text exactly fills a line, that space used to spill
%  onto a new, empty line and leave a gap under the bullet)
\newcommand{\myItem}[1]{%
  \item{#1\unskip\vspace{-2pt}}%
}

% Right-aligned date/place at the end of a line. If the line is too long, it moves to the
% next line and stays right-aligned (plain \hfill would leave it on the left).
\newcommand{\rightdate}[1]{\unskip\nobreak\hfil\penalty50\hskip1em\hbox{}\nobreak\hfill #1}

% Education information
\newcommand{\eduHeading}[4]{
  \renewcommand{\arraystretch}{1.2}
    \begin{tabular}[t]{p{13.74cm}}
      \emph{#1}\rightdate{#2} \\
      \textit{#3}\rightdate{#4} \\
    \end{tabular}\par\nobreak\vspace{-7pt}
}

% Internship information
\newcommand{\internHeading}[3]{
  \renewcommand{\arraystretch}{1.2}
    \begin{tabular}[t]{p{13.74cm}}
      \emph{#1} $|$ #2 \hfill #3 \\
    \end{tabular}\vspace{-7pt}
}

% Project information
% (bottom space tightened from 2pt to -7pt, as in \eduHeading, because every project here has bullet points)
\newcommand{\projHeading}[3]{
  \renewcommand{\arraystretch}{1.2}
    \begin{tabular}[t]{p{13.74cm}}
      \textbf{#1} \hfill \\
      \textit{#2}\rightdate{#3} \\
    \end{tabular}\par\nobreak\vspace{-7pt}
}

% Title of a paper followed by bullet points (Conferences and Publications)
% (one row only, which leaves the first bullet 0.9pt closer than under the two-row headings
%  above; -6.1pt instead of -7pt evens that out)
\newcommand{\pubHeading}[1]{
  \renewcommand{\arraystretch}{1.2}
    \begin{tabular}[t]{p{13.74cm}}
      \textbf{#1} \\
    \end{tabular}\par\nobreak\vspace{-6.1pt}
}

%------------------------------------
% Added for a multi-page CV (same look as \sectionBlock above).
% \sectionBlock is one unbreakable box, so a long section cannot continue on the next page.
% Long sections use this environment instead; it can break between entries and bullet points:
%   \begin{longSection}{\section{Title}}
%     ...entries, separated by blank lines...
%   \end{longSection}
%------------------------------------
\RequirePackage{changepage}
\RequirePackage{needspace}
\newlength{\contentIndent}  % where the content column starts (as in \sectionBlock)
\setlength{\contentIndent}{\dimexpr\textwidth-13.85cm\relax}
\newenvironment{longSection}[1]{%
  \par\Needspace{8\baselineskip}% don't start a section in the last few lines of a page
  \noindent
  \begin{adjustwidth}{\contentIndent}{0pt}%
  \setlength{\parindent}{0pt}%
  \@beginparpenalty=\@M % never break between a heading and the first bullet under it
  \raggedright
  % the title hangs in the left column from the top of the first entry; a zero-height box,
  % so it never changes the spacing of the content next to it
  % (boxes placed between paragraphs sit at the page's left edge, so no shift is needed)
  \vbox to 0pt{\hbox{\parbox[t]{2.7cm}{\raggedright #1}}\vss}%
  \nointerlineskip
  \ignorespaces
}{%
  \end{adjustwidth}%
  \addvspace{25pt}% same gap after the section as \sectionBlock
}

% Sub-heading inside Research Experience (kept on the same page as the next entry)
\newcommand{\clusterHeading}[1]{\textit{\emph{#1}}\par\nobreak}

% A second programme under the same institution, styled like the second row of \eduHeading
\newcommand{\eduLine}[2]{
  \vspace{3pt}
  \renewcommand{\arraystretch}{1.2}
    \begin{tabular}[t]{p{13.74cm}}
      \textit{#1}\rightdate{#2} \\
    \end{tabular}\vspace{-7pt}
}

% Links shown as [PDF], [Slides], [Link]
\RequirePackage[hidelinks]{hyperref}
\newcommand{\weblink}[2]{\textnormal{[\href{#1}{\underline{#2}}]}}
